# Copy this file to .env and fill in real values.

# --- Database (required) ---
DATABASE_URL="postgresql://user:password@localhost:5432/battery_central"

# --- Optional fallbacks for settings normally configured from the dashboard's
#     Settings modal (these are only used if the matching row isn't set in
#     the Setting table yet) ---
API_SECRET_KEY="secret_batt_2026"
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# --- Feature 15: API rate limiting (all optional, sensible defaults apply) ---
# General limit applied to every /api/* route except /api/battery/update.
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
# Separate, more generous bucket for device battery updates.
RATE_LIMIT_BATTERY_MAX=180
RATE_LIMIT_BATTERY_WINDOW_MS=60000

# --- Feature 10: MQTT background worker (scripts/mqtt-listener.js / `npm run mqtt`) ---
# Only needed if you run the MQTT worker. See README.md for the full
# Mosquitto + VPS setup guide.
MQTT_BROKER_URL="mqtt://your-vps-ip:1883"
MQTT_USERNAME=""
MQTT_PASSWORD=""
MQTT_TOPIC="battery-central/+/status"
# Base URL of this Next.js app, used by the MQTT worker to call
# POST /api/battery/update.
APP_BASE_URL="http://localhost:3000"
