datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Device {
  id               String       @id @default(uuid())
  name             String
  platform         String       // e.g., "Windows", "iOS", "Android", "ESP32"
  batteryLevel     Int          // 0-100
  isCharging       Boolean
  prevBattery      Int?         // Previous battery level for rate calculation
  prevUpdatedAt    DateTime?    // Previous update timestamp for rate calculation
  timeRemaining         Int?         // Estimated minutes remaining (to full or empty)
  pendingIsCharging     Boolean?     // Pending charging state awaiting debounce confirmation
  pendingChargingSince  DateTime?    // When the pending charging state was first received
  acceptingUpdates Boolean      @default(true) // Enable/disable receiving requests
  order            Int          @default(0)    // Display order on dashboard
  updatedAt        DateTime     @updatedAt

  // --- Custom alert thresholds per device (Feature 4) ---
  lowBatteryThreshold   Int      @default(15)   // % level that triggers a "low battery" alert for this device
  offlineTimeoutMinutes Int      @default(60)   // minutes without an update before this device is considered offline
  alertEnabled          Boolean  @default(true) // master switch for all alerts on this device

  // --- Geolocation (Feature 11) ---
  lastLat          Float?       // last reported latitude
  lastLng          Float?       // last reported longitude

  logs             BatteryLog[]
}

model BatteryLog {
  id           String   @id @default(uuid())
  deviceId     String
  device       Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  batteryLevel Int
  isCharging   Boolean
  eventType    String   // e.g., "PLUGGED_IN", "UNPLUGGED", "LEVEL_UPDATE", "INITIAL"
  createdAt    DateTime @default(now())

  @@index([deviceId, createdAt])
}

model Setting {
  key   String @id
  value String
}

// Public share link for embedding a read-only status widget (Feature 14)
model ShareToken {
  id        String    @id @default(uuid())
  token     String    @unique
  deviceIds String[]  // devices exposed through this share link
  expiresAt DateTime? // null = never expires
  createdAt DateTime  @default(now())

  @@index([token])
}

model ApiLog {
  id           String   @id @default(uuid())
  method       String   // "GET", "POST", "PATCH", "DELETE"
  path         String   // e.g., "/api/battery/update"
  status       Int      // e.g., 200, 400, 401, 500
  durationMs   Int      // Execution time in milliseconds
  ip           String?  // Source IP or identifier
  userAgent    String?  // e.g., "MacroDroid", "Tasker", "ESP32", "Mozilla/5.0"
  requestBody  String?  // JSON string of request body or query params
  responseBody String?  // JSON string of response payload
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([path, status])
}
